<resources>
    <style name="CalendarDateText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@android:color/black</item>
    </style>
    <style name="CalendarWeekDayText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@android:color/darker_gray</item>
    </style>
    <style name="CalendarHeaderText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@android:color/holo_blue_dark</item>
    </style>
    <style name="Shape.RoundedLg">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape">
        <item name="android:background">@drawable/bg_rounded</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="TimePickerTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:timePickerMode">spinner</item>
    </style>
</resources> 