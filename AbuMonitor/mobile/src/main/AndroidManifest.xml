<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ESTOS SON PERMISOS PARA EL MOBILE -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- ESTOS SON PERMISOS PARA ENVIAR DATOS A WEAR OS -->
    <uses-permission android:name="com.google.android.gms.permission.WEARABLE_DATA_CHANGED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- ESTOS SON PERMISOS PARA USAR BLUETOOTH -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name="com.example.abumonitor.AbuMonitorApplicationMobile"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_old_people_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_old_people_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight"
        >

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!--ACTIVITY lAUNCHER-->
            <activity
           android:name=".ui.view.activities.MainMenuActivity"
           android:launchMode="singleTask"
           android:exported="true">
           <intent-filter>
               <action android:name="android.intent.action.MAIN" />

               <category android:name="android.intent.category.LAUNCHER" />
           </intent-filter>
       </activity>

       <!--OTHER ACTIVITIES-->
       <activity
           android:name=".ui.view.activities.areas_geofence.MapsDefineAreasActivity"
           android:exported="true">
       </activity>
        <activity
            android:name=".ui.view.activities.elderly_track.MapsElderlyTrackActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".ui.view.activities.calendar_assistance.MapsAssistance"
            android:exported="true">
        </activity>
       <activity android:name=".ui.view.activities.utils.EnableGpsDialog" />
        <activity android:name=".ui.view.activities.common.PropertiesGeofenceActivity" />
        <activity
            android:name=".ui.view.activities.contact.ContactsActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light">
        </activity>
        <activity
            android:name=".ui.view.activities.calendar_assistance.AssistanceAddActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light">
        </activity>
        <activity
            android:name=".ui.view.activities.calendar_assistance.AssistanceCalendarActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light">
        </activity>
        <activity android:name=".ui.view.activities.calendar_assistance.AssistanceDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light">
        </activity>


        <!--SERVICES AND OTHERS-->
        <service
            android:enabled="true"
            android:name=".ui.utils.services.GeofencesServices"
            android:label="Geofences Intent Service"
            android:foregroundServiceType="location">
        </service>
        <service
            android:name=".ui.utils.services.WearableDataListenerService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <service
            android:name=".ui.utils.services.SenderToWearableService"
            android:exported="false">
        </service>
        <receiver
            android:name=".ui.utils.broadcast.GeofenceBroadcastReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.example.app.ACTION_GEOFENCE_EVENT"/>
            </intent-filter>
        </receiver>

        <receiver android:name=".ui.utils.broadcast.NotificationCancelReceiver"/>
    </application>

</manifest>